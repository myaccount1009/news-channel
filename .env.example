# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: শুধু server এ ব্যবহার হয়, কখনো browser এ যায় না। কাউকে দেবেন না।
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin panel login (/admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
# কমপক্ষে ১৬ অক্ষরের random string (login cookie সই করতে লাগে)
SESSION_SECRET=

# ---- n8n / API ----
# n8n এই key টা `x-api-key` header এ পাঠাবে। একাধিক key কমা দিয়ে দেওয়া যায়।
API_KEY=
# API দিয়ে status না দিলে কী হবে: published (সরাসরি প্রকাশ) অথবা draft (আগে review)
API_DEFAULT_STATUS=published
# API তে category না দিলে এই slug এ যাবে
DEFAULT_CATEGORY_SLUG=news

# ---- Site ----
SITE_NAME=নিউজ পোর্টাল
SITE_TAGLINE=দেশ ও বিশ্বের সর্বশেষ সংবাদ
# Vercel এ deploy হলে আপনার আসল URL (শেষে / ছাড়া)
SITE_URL=http://localhost:3000
